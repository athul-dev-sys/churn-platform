{
  "family": "churn-model-service",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::195616721931:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "churn-model-service",
      "image": "195616721931.dkr.ecr.ap-south-2.amazonaws.com/churn-model-service:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "PORT",
          "value": "8000"
        },
        {
          "name": "S3_BUCKET_NAME",
          "value": "churn-platform-athul-hackathon"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/churn-model-service",
          "awslogs-region": "ap-south-2",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}