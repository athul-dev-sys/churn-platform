{
  "family": "churn-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::195616721931:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "churn-api",
      "image": "195616721931.dkr.ecr.ap-south-2.amazonaws.com/churn-api:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3000,
          "hostPort": 3000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "PORT",
          "value": "3000"
        },
        {
          "name": "DATABASE_URL",
          "value": "postgresql://neondb_owner:npg_zPXZH6BE7yUD@ep-lingering-band-axdroi2g-pooler.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require"
        },
        {
          "name": "MODEL_SERVICE_URL",
          "value": "http://172.31.14.74:8000"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/churn-api",
          "awslogs-region": "ap-south-2",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
